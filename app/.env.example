# Copy to .env.local (local) or set in Vercel → Settings → Environment Variables.

MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/skillbridge

# Required in production — prevents Auth.js 500 on /api/auth/session
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Auth.js v5: canonical URL of the app (production: https://your-app.vercel.app)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ADMIN_EMAIL=admin@skillbridge.gov.in

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional
RESEND_API_KEY=
EMAIL_FROM=SkillBridge <noreply@example.com>
CRON_SECRET=
