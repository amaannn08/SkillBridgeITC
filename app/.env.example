# ─────────────────────────────────────────────────────────────
# SkillBridge ITC — Environment Variables Reference
# Copy this file to .env.local for local development
# Set production values in Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/skillbridge?retryWrites=true&w=majority

# ── Auth.js v5 ───────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Canonical app URL — MUST match your deployment domain
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — create at console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Admin Bootstrap ───────────────────────────────────────────
# First registered Google account with this email becomes super_admin automatically
ADMIN_EMAIL=admin@skillbridge.gov.in

# ── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── File Storage (optional) ───────────────────────────────────
# Default: local filesystem under app/uploads/resumes/
# Set these to enable S3-compatible storage (e.g. AWS S3, Cloudflare R2)
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=skillbridge-uploads

# ── Email (optional) ─────────────────────────────────────────
# Leave blank to suppress outbound emails (dev mode logs to console)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=SkillBridge <noreply@yourdomain.com>

# ── Cron Security ────────────────────────────────────────────
# Used to authenticate /api/cron/* routes from Vercel Cron
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here
